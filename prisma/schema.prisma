generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id               String                   @id @default(cuid())
  name             String
  slug             String                   @unique
  logoUrl          String?
  logoAssetId      String?
  logoAsset        MediaAsset?              @relation("TenantLogoAsset", fields: [logoAssetId], references: [id], onDelete: SetNull)
  websiteUrl       String?
  snsUrl           String?
  members          TenantMember[]
  maps             Map[]
  spots            Spot[]
  categories       Category[]
  mediaAssets      MediaAsset[]             @relation("TenantMediaAssets")
  invitations      OrganizationInvitation[]
  auditEvents      AuditEvent[]
  legalAcceptances LegalAcceptance[]
  onboardingState  TenantOnboardingState    @default(SETUP)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
}

enum MailDeliveryStatus {
  PENDING
  SENT
  FAILED
}

model MailDelivery {
  id                String             @id @default(cuid())
  purpose           String
  recipient         String
  providerMessageId String?
  status            MailDeliveryStatus @default(PENDING)
  attemptCount      Int                @default(0)
  errorCategory     String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  sentAt            DateTime?

  @@index([status, createdAt])
  @@index([recipient, createdAt])
}

model RateLimitBucket {
  key       String   @id
  namespace String
  count     Int      @default(1)
  windowEnd DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([namespace, windowEnd])
}

model User {
  id                    String                   @id @default(cuid())
  email                 String                   @unique
  displayName           String?
  passwordHash          String
  tenantMembers         TenantMember[]
  mapMembers            MapMember[]
  createdInvitations    OrganizationInvitation[] @relation("InvitationCreator")
  acceptedInvitations   OrganizationInvitation[] @relation("InvitationAcceptor")
  passwordResetTokens   PasswordResetToken[]
  spotAssignments       SpotEditorAssignment[]   @relation("SpotEditorUser")
  assignedSpotEditors   SpotEditorAssignment[]   @relation("SpotEditorAssigner")
  authoredSpotRevisions SpotRevision[]           @relation("SpotRevisionAuthor")
  reviewedSpotRevisions SpotRevision[]           @relation("SpotRevisionReviewer")
  publicReleases        PublicRelease[]
  auditEvents           AuditEvent[]
  legalAcceptances      LegalAcceptance[]
  signupIntents         SignupIntent[]
  emailVerifiedAt       DateTime?
  isActive              Boolean                  @default(true)
  authVersion           Int                      @default(1)
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
}

enum TenantOnboardingState {
  SETUP
  ACTIVE
}

model SignupIntent {
  id                    String    @id @default(cuid())
  email                 String
  passwordHash          String
  organizationName      String
  verificationTokenHash String    @unique
  expiresAt             DateTime
  verifiedAt            DateTime?
  completedAt           DateTime?
  termsVersion          String
  privacyVersion        String
  createdUserId         String?
  createdUser           User?     @relation(fields: [createdUserId], references: [id], onDelete: SetNull)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([email, createdAt])
  @@index([expiresAt, completedAt])
}

model LegalAcceptance {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  termsVersion   String
  privacyVersion String
  acceptedAt     DateTime @default(now())

  @@index([userId, acceptedAt])
  @@index([tenantId, acceptedAt])
}

model AuditEvent {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorUserId String?
  actorUser   User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String
  targetType  String
  targetId    String
  mapId       String?
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, targetType, targetId, createdAt])
  @@index([mapId, createdAt])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum InvitationPurpose {
  ORGANIZATION_MEMBER
  SPOT_EDITOR
}

model OrganizationInvitation {
  id           String            @id @default(cuid())
  tenantId     String
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  targetSpotId String?
  targetSpot   Spot?             @relation(fields: [targetSpotId], references: [id], onDelete: Cascade)
  email        String
  tokenHash    String            @unique
  purpose      InvitationPurpose @default(ORGANIZATION_MEMBER)
  status       InvitationStatus  @default(PENDING)
  expiresAt    DateTime
  createdById  String
  createdBy    User              @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  acceptedById String?
  acceptedBy   User?             @relation("InvitationAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)
  acceptedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([tenantId, createdAt])
  @@index([tenantId, email, status])
  @@index([targetSpotId, status])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

enum TenantRole {
  OWNER
  MEMBER
}

model TenantMember {
  id        String     @id @default(cuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      TenantRole @default(MEMBER)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([tenantId, userId])
  @@index([userId])
  @@index([tenantId, role])
}

enum MapRole {
  EDITOR
}

enum MapView {
  ILLUSTRATION
  REAL
}

model MapMember {
  id        String   @id @default(cuid())
  mapId     String
  map       Map      @relation(fields: [mapId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      MapRole  @default(EDITOR)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([mapId, userId])
  @@index([userId])
}

model Map {
  id                   String                @id @default(cuid())
  tenantId             String
  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                 String
  slug                 String                @unique
  organizationName     String?
  logoUrl              String?
  logoAssetId          String?
  logoAsset            MediaAsset?           @relation("MapLogoAsset", fields: [logoAssetId], references: [id], onDelete: SetNull)
  websiteUrl           String?
  snsUrl               String?
  seoTitle             String?
  seoDescription       String?
  seoImageAssetId      String?
  seoImageAsset        MediaAsset?           @relation("MapSeoImageAsset", fields: [seoImageAssetId], references: [id], onDelete: SetNull)
  isPublished          Boolean               @default(false)
  illustrationEnabled  Boolean               @default(true)
  realMapEnabled       Boolean               @default(false)
  defaultMapView       MapView               @default(ILLUSTRATION)
  defaultLocale        String                @default("ja")
  enabledLocales       String[]              @default(["ja"])
  translations         MapTranslation[]
  releases             PublicRelease[]       @relation("MapReleases")
  currentReleaseId     String?               @unique
  currentRelease       PublicRelease?        @relation("MapCurrentRelease", fields: [currentReleaseId], references: [id], onDelete: SetNull)
  dailyAnalytics       MapDailyAnalytics[]
  spotDailyAnalytics   SpotDailyAnalytics[]
  floors               MapFloor[]
  categories           Category[]
  spotFieldDefinitions SpotFieldDefinition[]
  members              MapMember[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([tenantId])
  @@index([seoImageAssetId])
}

model PublicRelease {
  id              String    @id @default(cuid())
  mapId           String
  map             Map       @relation("MapReleases", fields: [mapId], references: [id], onDelete: Cascade)
  currentForMap   Map?      @relation("MapCurrentRelease")
  createdBy       String
  creator         User      @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  status          String    @default("BUILDING")
  manifestKey     String?
  failureMetadata Json?
  createdAt       DateTime  @default(now())
  readyAt         DateTime?

  @@index([mapId, createdAt])
  @@index([mapId, status])
}

model MapDailyAnalytics {
  id        String   @id @default(cuid())
  tenantId  String
  mapId     String
  map       Map      @relation(fields: [mapId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  viewCount Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([mapId, date])
  @@index([tenantId, date])
}

model SpotDailyAnalytics {
  id        String   @id @default(cuid())
  tenantId  String
  mapId     String
  map       Map      @relation(fields: [mapId], references: [id], onDelete: Cascade)
  spotId    String
  spot      Spot     @relation(fields: [spotId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  viewCount Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([spotId, date])
  @@index([tenantId, mapId, date])
}

model MapTranslation {
  id          String   @id @default(cuid())
  mapId       String
  map         Map      @relation(fields: [mapId], references: [id], onDelete: Cascade)
  locale      String
  name        String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([mapId, locale])
  @@index([locale])
}

model Category {
  id             String                @id @default(cuid())
  tenantId       String
  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mapId          String
  map            Map                   @relation(fields: [mapId], references: [id], onDelete: Cascade)
  name           String
  order          Int                   @default(0)
  iconType       String?
  iconPresetId   String?
  iconImageUrl   String?
  iconAssetId    String?
  iconAsset      MediaAsset?           @relation("CategoryIconAsset", fields: [iconAssetId], references: [id], onDelete: SetNull)
  spotCategories SpotCategory[]
  translations   CategoryTranslation[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId, order])
  @@index([mapId, order])
}

model CategoryTranslation {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  locale     String
  name       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([categoryId, locale])
  @@index([locale])
}

model MapFloor {
  id                  String            @id @default(cuid())
  mapId               String
  map                 Map               @relation(fields: [mapId], references: [id], onDelete: Cascade)
  name                String
  illustrationUrl     String
  illustrationAssetId String?
  illustrationAsset   MediaAsset?       @relation("FloorIllustrationAsset", fields: [illustrationAssetId], references: [id], onDelete: SetNull)
  imageWidth          Int
  imageHeight         Int
  order               Int               @default(0)
  refAImageX          Float?
  refAImageY          Float?
  refALat             Float?
  refALng             Float?
  refBImageX          Float?
  refBImageY          Float?
  refBLat             Float?
  refBLng             Float?
  spots               Spot[]
  decorations         FloorDecoration[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([mapId, order])
}

model Spot {
  id                     String                      @id @default(cuid())
  tenantId               String
  tenant                 Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  floorId                String
  floor                  MapFloor                    @relation(fields: [floorId], references: [id], onDelete: Cascade)
  name                   String
  spotCategories         SpotCategory[]
  description            String?
  address                String?
  website                String?
  x                      Float?
  y                      Float?
  lat                    Float?
  lng                    Float?
  photosJson             Json                        @default("[]")
  hoursText              String?
  holidayText            String?
  phone                  String?
  pinIconType            String                      @default("preset")
  pinIconId              String?
  pinIconImageUrl        String?
  pinIconAssetId         String?
  pinIconAsset           MediaAsset?                 @relation("SpotPinAsset", fields: [pinIconAssetId], references: [id], onDelete: SetNull)
  photos                 SpotPhoto[]
  fieldValues            SpotFieldValue[]
  editorAssignment       SpotEditorAssignment?
  revisions              SpotRevision[]
  translations           SpotTranslation[]
  fieldValueTranslations SpotFieldValueTranslation[]
  dailyAnalytics         SpotDailyAnalytics[]
  targetedInvitations    OrganizationInvitation[]
  liveVersion            Int                         @default(1)
  pinColor               String                      @default("#C7401F")
  pinSize                String                      @default("medium")
  importance             String                      @default("normal")
  isPublished            Boolean                     @default(false)
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt

  @@index([tenantId])
  @@index([floorId])
  @@index([floorId, isPublished])
}

model SpotTranslation {
  id          String   @id @default(cuid())
  spotId      String
  spot        Spot     @relation(fields: [spotId], references: [id], onDelete: Cascade)
  locale      String
  name        String?
  description String?
  address     String?
  hoursText   String?
  holidayText String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([spotId, locale])
  @@index([locale])
}

model SpotEditorAssignment {
  spotId       String   @id
  spot         Spot     @relation(fields: [spotId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation("SpotEditorUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedById String
  assignedBy   User     @relation("SpotEditorAssigner", fields: [assignedById], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

enum SpotRevisionStatus {
  PENDING
  APPROVED
  REJECTED
}

model SpotRevision {
  id           String              @id @default(cuid())
  spotId       String
  spot         Spot                @relation(fields: [spotId], references: [id], onDelete: Cascade)
  authorId     String
  author       User                @relation("SpotRevisionAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  reviewerId   String?
  reviewer     User?               @relation("SpotRevisionReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  status       SpotRevisionStatus  @default(PENDING)
  payload      Json
  baseVersion  Int
  rejectReason String?
  reviewedAt   DateTime?
  photos       SpotRevisionPhoto[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([spotId, status, createdAt])
  @@index([authorId, status])
}

model SpotRevisionPhoto {
  revisionId String
  revision   SpotRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  assetId    String
  asset      MediaAsset   @relation(fields: [assetId], references: [id], onDelete: Restrict)
  order      Int          @default(0)
  createdAt  DateTime     @default(now())

  @@id([revisionId, assetId])
  @@index([revisionId, order])
  @@index([assetId])
}

model FloorDecoration {
  id        String     @id @default(cuid())
  floorId   String
  floor     MapFloor   @relation(fields: [floorId], references: [id], onDelete: Cascade)
  assetId   String
  asset     MediaAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)
  x         Float
  y         Float
  width     Float
  rotation  Float      @default(0)
  order     Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([floorId, order])
  @@index([assetId])
}

model SpotFieldDefinition {
  id                String                           @id @default(cuid())
  mapId             String
  map               Map                              @relation(fields: [mapId], references: [id], onDelete: Cascade)
  kind              String
  semanticKey       String?
  label             String
  type              String
  enabled           Boolean                          @default(true)
  publicVisible     Boolean                          @default(true)
  required          Boolean                          @default(false)
  order             Int                              @default(0)
  values            SpotFieldValue[]
  translations      SpotFieldDefinitionTranslation[]
  valueTranslations SpotFieldValueTranslation[]
  createdAt         DateTime                         @default(now())
  updatedAt         DateTime                         @updatedAt

  @@unique([mapId, semanticKey])
  @@index([mapId, order])
}

model SpotFieldDefinitionTranslation {
  id                String              @id @default(cuid())
  fieldDefinitionId String
  fieldDefinition   SpotFieldDefinition @relation(fields: [fieldDefinitionId], references: [id], onDelete: Cascade)
  locale            String
  label             String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([fieldDefinitionId, locale])
  @@index([locale])
}

model SpotFieldValue {
  id                String              @id @default(cuid())
  spotId            String
  spot              Spot                @relation(fields: [spotId], references: [id], onDelete: Cascade)
  fieldDefinitionId String
  fieldDefinition   SpotFieldDefinition @relation(fields: [fieldDefinitionId], references: [id], onDelete: Restrict)
  valueJson         Json
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([spotId, fieldDefinitionId])
  @@index([fieldDefinitionId])
}

model SpotFieldValueTranslation {
  id                String              @id @default(cuid())
  spotId            String
  spot              Spot                @relation(fields: [spotId], references: [id], onDelete: Cascade)
  fieldDefinitionId String
  fieldDefinition   SpotFieldDefinition @relation(fields: [fieldDefinitionId], references: [id], onDelete: Cascade)
  locale            String
  value             String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([spotId, fieldDefinitionId, locale])
  @@index([fieldDefinitionId, locale])
}

model MediaAsset {
  id                 String              @id @default(cuid())
  tenantId           String
  tenant             Tenant              @relation("TenantMediaAssets", fields: [tenantId], references: [id], onDelete: Cascade)
  storageKey         String              @unique
  originalFilename   String
  mimeType           String
  width              Int
  height             Int
  fileSize           Int
  sha256             String?
  mapLogos           Map[]               @relation("MapLogoAsset")
  mapSeoImages       Map[]               @relation("MapSeoImageAsset")
  floorIllustrations MapFloor[]          @relation("FloorIllustrationAsset")
  categoryIcons      Category[]          @relation("CategoryIconAsset")
  spotPins           Spot[]              @relation("SpotPinAsset")
  spotPhotos         SpotPhoto[]
  revisionPhotos     SpotRevisionPhoto[]
  decorations        FloorDecoration[]
  tenantLogos        Tenant[]            @relation("TenantLogoAsset")
  variants           MediaVariant[]
  processingStatus   String              @default("PENDING")
  processingError    String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([tenantId, createdAt])
  @@index([tenantId, sha256])
}

model MediaVariant {
  id         String     @id @default(cuid())
  assetId    String
  asset      MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  kind       String
  format     String     @default("webp")
  storageKey String     @unique
  width      Int
  height     Int
  fileSize   Int
  createdAt  DateTime   @default(now())

  @@unique([assetId, kind, format])
  @@index([assetId])
}

model SpotPhoto {
  id        String     @id @default(cuid())
  spotId    String
  spot      Spot       @relation(fields: [spotId], references: [id], onDelete: Cascade)
  assetId   String
  asset     MediaAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)
  order     Int        @default(0)
  createdAt DateTime   @default(now())

  @@unique([spotId, assetId])
  @@index([spotId, order])
  @@index([assetId])
}

model SpotCategory {
  spotId     String
  spot       Spot     @relation(fields: [spotId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([spotId, categoryId])
  @@index([categoryId])
}
