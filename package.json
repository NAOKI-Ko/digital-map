{
  "name": "digital-map",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "backup:db": "bash scripts/backup-db.sh",
    "backup:media": "node --import tsx scripts/backup-media.ts backup",
    "backup:verify": "node --import tsx scripts/backup-verify.ts",
    "backup:retention": "node --import tsx scripts/backup-retention.ts",
    "restore:db": "bash scripts/restore-db.sh",
    "restore:media": "node --import tsx scripts/backup-media.ts restore",
    "audit:image-spatial-migration": "node --import tsx scripts/audit-image-spatial-migration.ts",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "media:backfill": "node --import tsx scripts/media-backfill.ts",
    "media:gc": "node --import tsx scripts/media-gc.ts",
    "preview": "nuxt preview",
    "postinstall": "prisma generate && nuxt prepare",
    "db:seed": "prisma db seed",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "test": "vitest run",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "maplibre-gl": "^6.9.0",
    "nuxt": "^4.5.2",
    "nuxt-auth-utils": "^0.5.30",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.4",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@nuxt/devtools": "3.3.1",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@vue/test-utils": "^2.5.0",
    "axe-core": "^4.13.0",
    "dotenv": "^17.4.2",
    "happy-dom": "^20.14.5",
    "prisma": "^7.10.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  },
  "packageManager": "pnpm@11.9.0"
}
