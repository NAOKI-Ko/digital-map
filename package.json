{
  "name": "digital-map",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "backup:db": "bash scripts/backup-db.sh",
    "backup:media": "node --import tsx scripts/backup-media.ts backup",
    "backup:verify": "node --import tsx scripts/backup-verify.ts",
    "backup:retention": "node --import tsx scripts/backup-retention.ts",
    "restore:db": "bash scripts/restore-db.sh",
    "restore:media": "node --import tsx scripts/backup-media.ts restore",
    "audit:image-spatial-migration": "node --import tsx scripts/audit-image-spatial-migration.ts",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "media:backfill": "node --import tsx scripts/media-backfill.ts",
    "media:gc": "node --import tsx scripts/media-gc.ts",
    "preview": "nuxt preview",
    "postinstall": "prisma generate && nuxt prepare",
    "db:seed": "prisma db seed",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "test": "vitest run",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "bcryptjs": "^3.0.0",
    "maplibre-gl": "^5.24.0",
    "nuxt": "^4.0.0",
    "nuxt-auth-utils": "^0.5.29",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.4",
    "vee-validate": "^4.15.0",
    "vue": "^3.5.0",
    "vue-router": "^5.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/pg": "^8.15.0",
    "@types/qrcode": "^1.5.6",
    "@vue/test-utils": "^2.5.0",
    "axe-core": "^4.13.0",
    "dotenv": "^17.0.0",
    "happy-dom": "^20.14.5",
    "prisma": "^7.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0",
    "vue-tsc": "^3.1.0"
  },
  "packageManager": "pnpm@11.9.0"
}
